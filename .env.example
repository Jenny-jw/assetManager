# Product branch — copy to repo-root `.env` (never commit).

# PostgreSQL — required for docker compose + pgAdmin
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Local uvicorn only (host = localhost). Omit if you only use `docker compose up` for the API.
# postgresql+psycopg://<user>:<password>@localhost:<port>/<database>
POSTGRES_URL=

DEPLOY_CONFIG_PATH=deploy/config.yaml
JWT_SECRET_KEY=
JWT_COOKIE_SECURE=false
